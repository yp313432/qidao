<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
  <!--
    通知栏小图标（状态栏那一枚）。

    必须是**单色剪影**：系统只取 alpha 通道，再用自己的颜色染色。
    用 App 的 adaptive icon（彩色底 + 前景）当小图标，Android 8+ 会认为不合规 ——
    有的机型图标变白方块，有的直接把整条通知丢掉。
    用户 m10397 报的"后台通知不弹"就是这一层（`WakeNotify` 原来传的是
    `getApplicationInfo().icon`，那是 adaptive icon）。
  -->
  <path
      android:fillColor="#FFFFFF"
      android:pathData="M12,6.4m-2.9,0a2.9,2.9 0 1,0 5.8,0a2.9,2.9 0 1,0 -5.8,0" />
  <path
      android:fillColor="@android:color/transparent"
      android:strokeColor="#FFFFFF"
      android:strokeWidth="1.7"
      android:strokeLineCap="round"
      android:pathData="M5.6,14.6c2,1.2 4.1,1.8 6.4,1.8s4.4,-0.6 6.4,-1.8" />
  <path
      android:fillColor="@android:color/transparent"
      android:strokeColor="#FFFFFF"
      android:strokeWidth="1.4"
      android:strokeLineCap="round"
      android:pathData="M7.8,18c1.4,0.7 2.8,1.05 4.2,1.05s2.8,-0.35 4.2,-1.05" />
</vector>
